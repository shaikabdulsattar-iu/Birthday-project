<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday ❤️</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Comic Sans MS", cursive, sans-serif;
      overflow-x: hidden;
      background: linear-gradient(135deg, #ffd6e7, #fff0f5);
      color: #5a2a3a;
    }

    /* ---------- SECTIONS ---------- */

    .page {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px 20px;
      position: relative;
    }

    .hidden {
      display: none;
    }

    /* ---------- FIRST PAGE ---------- */

    #welcome {
      background:
        radial-gradient(circle at top left, #fff 0%, transparent 30%),
        linear-gradient(135deg, #ffc8dd, #ffe5ec, #fff0f5);
    }

    .card {
      background: rgba(255,255,255,0.85);
      padding: 45px 25px;
      width: min(90%, 500px);
      border-radius: 30px;
      box-shadow: 0 15px 40px rgba(255, 80, 130, 0.25);
      animation: appear 1.2s ease;
    }

    .cake {
      font-size: 90px;
      animation: bounce 1.5s infinite;
    }

    h1 {
      font-size: clamp(35px, 8vw, 65px);
      color: #ff4f81;
      margin: 15px 0;
      text-shadow: 2px 2px white;
    }

    .subtitle {
      font-size: 19px;
      line-height: 1.7;
      margin-bottom: 25px;
    }

    button {
      border: none;
      padding: 15px 35px;
      border-radius: 50px;
      background: linear-gradient(135deg, #ff4f81, #ff7aa2);
      color: white;
      font-size: 18px;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(255, 79, 129, 0.35);
      transition: 0.3s;
    }

    button:hover {
      transform: scale(1.08);
    }

    /* ---------- MESSAGE PAGE ---------- */

    #messagePage {
      background: linear-gradient(135deg, #fff0f5, #ffd6e7);
    }

    .letter {
      background: white;
      width: min(90%, 650px);
      padding: 40px 25px;
      border-radius: 25px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.12);
      animation: appear 1s ease;
    }

    .letter h2 {
      color: #ff4f81;
      font-size: 35px;
      margin-bottom: 20px;
    }

    .letter p {
      font-family: Arial, sans-serif;
      font-size: 18px;
      line-height: 1.8;
      margin-bottom: 25px;
    }

    /* ---------- MEMORIES ---------- */

    #memories {
      flex-direction: column;
      background: linear-gradient(#ffe5ec, #fff);
    }

    #memories h2 {
      font-size: 40px;
      color: #ff4f81;
      margin-bottom: 35px;
    }

    .photos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 25px;
      width: min(100%, 900px);
    }

    .photo-card {
      background: white;
      padding: 12px 12px 25px;
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.12);
      transform: rotate(-2deg);
      transition: 0.4s;
    }

    .photo-card:nth-child(even) {
      transform: rotate(2deg);
    }

    .photo-card:hover {
      transform: rotate(0) scale(1.05);
    }

    .photo-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 15px;
    }

    .photo-card p {
      margin-top: 12px;
    }

    /* ---------- FINAL ---------- */

    #finalPage {
      background: linear-gradient(135deg, #ffb3c6, #ffe5ec);
    }

    .final-box {
      background: rgba(255,255,255,0.9);
      padding: 45px 25px;
      border-radius: 30px;
      width: min(90%, 600px);
      box-shadow: 0 15px 40px rgba(255, 70, 120, 0.25);
    }

    .big-heart {
      font-size: 100px;
      animation: heartbeat 1s infinite;
    }

    .final-box h2 {
      color: #ff3f78;
      font-size: 40px;
      margin: 15px;
    }

    /* ---------- FLOATING HEARTS ---------- */

    .heart {
      position: fixed;
      bottom: -30px;
      pointer-events: none;
      animation: floatUp linear forwards;
      z-index: 100;
    }

    /* ---------- MUSIC BUTTON ---------- */

    #musicBtn {
      position: fixed;
      right: 18px;
      top: 18px;
      width: 50px;
      height: 50px;
      padding: 0;
      z-index: 1000;
      font-size: 22px;
    }

    /* ---------- ANIMATIONS ---------- */

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }

    @keyframes floatUp {
      from {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
      }
      to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
      }
    }

    @media(max-width: 600px) {
      .photos {
        grid-template-columns: 1fr;
      }

      .photo-card {
        max-width: 300px;
        margin: auto;
      }
    }
  </style>
</head>

<body>

  <!-- Background Music -->
  <audio id="music" loop>
    <source src="birthday-song.mp3" type="audio/mpeg">
  </audio>

  <button id="musicBtn" onclick="toggleMusic()">🎵</button>

  <!-- PAGE 1 -->

  <section class="page" id="welcome">

    <div class="card">

      <div class="cake">🎂</div>

      <h1>Happy Birthday!</h1>

      <p class="subtitle">
        Today is a very special day because someone very special
        was born today! 💕
        <br><br>
        I made a little surprise just for you.
      </p>

      <button onclick="startSurprise()">
        Click Me 🎁
      </button>

    </div>

  </section>

  <!-- PAGE 2 -->

  <section class="page hidden" id="messagePage">

    <div class="letter">

      <h2>For You 💌</h2>

      <p>
        Happy Birthday to one of the most amazing people in my life! ❤️
        I hope your day is filled with happiness, laughter and beautiful
        memories.
      </p>

      <p>
        May all your dreams come true and may this new year of your life
        bring you success, peace and endless reasons to smile.
      </p>

      <p>
        Keep smiling because your smile makes everything more beautiful. ✨
      </p>

      <button onclick="showMemories()">
        Open Our Memories 📸
      </button>

    </div>

  </section>

  <!-- PAGE 3 -->

  <section class="page hidden" id="memories">

    <h2>Our Beautiful Memories ❤️</h2>

    <div class="photos">

      <div class="photo-card">
        <img src="images/photo1.jpg" alt="Memory 1">
        <p>A beautiful memory 💕</p>
      </div>

      <div class="photo-card">
        <img src="images/photo2.jpg" alt="Memory 2">
        <p>Moments worth remembering ✨</p>
      </div>

      <div class="photo-card">
        <img src="images/photo3.jpg" alt="Memory 3">
        <p>One of my favourites ❤️</p>
      </div>

    </div>

    <br><br>

    <button onclick="showFinal()">
      One Last Surprise 💝
    </button>

  </section>

  <!-- FINAL PAGE -->

  <section class="page hidden" id="finalPage">

    <div class="final-box">

      <div class="big-heart">❤️</div>

      <h2>You Are Special!</h2>

      <p class="subtitle">

        No matter where life takes us,
        I hope you always remember how special you are.

        <br><br>

        Once again...

        <br>

        <strong>Happy Birthday! 🎂🎉❤️</strong>

      </p>

      <button onclick="celebrate()">
        Celebrate 🎉
      </button>

    </div>

  </section>

  <script>

    const music = document.getElementById("music");

    function startSurprise() {

      music.play().catch(() => {});

      document.getElementById("welcome").classList.add("hidden");

      document.getElementById("messagePage").classList.remove("hidden");

      createHearts(20);

    }

    function showMemories() {

      document.getElementById("messagePage").classList.add("hidden");

      document.getElementById("memories").classList.remove("hidden");

      createHearts(15);

    }

    function showFinal() {

      document.getElementById("memories").classList.add("hidden");

      document.getElementById("finalPage").classList.remove("hidden");

      createHearts(30);

    }

    function toggleMusic() {

      if (music.paused) {

        music.play();

        document.getElementById("musicBtn").innerHTML = "🔊";

      } else {

        music.pause();

        document.getElementById("musicBtn").innerHTML = "🔇";

      }

    }

    function createHeart() {

      const heart = document.createElement("div");

      heart.className = "heart";

      const symbols = ["❤️", "💕", "💗", "💖", "✨"];

      heart.innerHTML =
        symbols[Math.floor(Math.random() * symbols.length)];

      heart.style.left =
        Math.random() * 100 + "vw";

      heart.style.fontSize =
        (15 + Math.random() * 25) + "px";

      heart.style.animationDuration =
        (3 + Math.random() * 4) + "s";

      document.body.appendChild(heart);

      setTimeout(() => {

        heart.remove();

      }, 7000);

    }

    function createHearts(number) {

      for (let i = 0; i < number; i++) {

        setTimeout(createHeart, i * 150);

      }

    }

    function celebrate() {

      createHearts(60);

    }

    /* Random hearts */

    setInterval(() => {

      if (Math.random() > 0.5) {

        createHeart();

      }

    }, 1200);

  </script>

</body>
</html>
